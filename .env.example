DEBUG=True
SECRET_KEY=replace-me

# Database
DATABASE_URL=postgres://dental:replace-with-a-random-secret@db:5432/dental
POSTGRES_PASSWORD=replace-with-a-random-secret

# Production PostgreSQL connections
DATABASE_URL_MIGRATOR=postgres://dental_migrator:replace-me@db:5432/dental
DATABASE_URL_RUNTIME=postgres://dental_runtime:replace-me@db:5432/dental

# Hosts and security
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://example.com

# API credentials
API_EMAIL=replace-me@example.com
API_PASSWORD=replace-me

# Email configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me@example.com
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=replace-me@example.com

# Docker (docker compose up)
# DATABASE_URL=postgres://dental:replace-with-a-random-secret@db:5432/dental
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
