FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci --no-audit --no-fund

COPY . .

RUN npm run build


FROM nginx:alpine

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist-vite/ /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
